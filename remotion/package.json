{
  "name": "neosaniye-remotion-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Dynamic collage motion-graphics renderer for the NeoSaniye production pipeline",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "render:fixture": "remotion render src/index.ts NeoSaniyeReel ../artifacts/remotion-fixture.mp4 --props=../fixtures/remotion/production.json --codec=h264 --crf=17 --pixel-format=yuv420p"
  },
  "dependencies": {
    "@remotion/cli": "4.0.499",
    "remotion": "4.0.499",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "typescript": "5.9.2"
  }
}
