node_modules/
out/
.env

# Written by the render script before bundling: it imports whatever scene
# overrides the episode ships. Generated, never edited by hand.
engine/episodeScenes.generated.ts

# THE REFERENCE KIT IS NOT OURS TO REDISTRIBUTE.
# episodes/netflix/ is built from the build-along's own artwork — generated
# likenesses, brand marks, a storefront — supplied for a local test of the
# engine and nothing else. It proved what it needed to prove: handed that
# material, this engine produces that reel. Publishing somebody else's kit
# from a public repository is a separate decision and not one a build makes
# on its own. Drop the kit into episodes/netflix/assets/ and re-plan.
episodes/netflix/

# WHAT YOU BRING BACK IS NOT SOURCE.
# `episodes/<id>/raw/` is the drop box for the generated pictures — original
# size, background still on. `broll:key` turns them into the cut-outs in
# `assets/`, and THOSE are what the render reads and what gets committed.
# Keeping both would double the repo for no gain: the raw drop can always be
# re-made from PROMPTS.md, the keyed cut-out cannot.
episodes/*/raw/
