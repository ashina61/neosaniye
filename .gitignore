node_modules/
out/
public/audio/*.mp3
public/audio/*.wav
public/audio/*.srt
.env
.env.*
.DS_Store
*.log

# Üretim çıktıları — build sonucu, kaynak değil. Bu satırlar eski .gitignore'da
# vardı ve Remotion yeniden yazımında silindiler; sonuç olarak yerel çalışma
# ağacında 2.4 GB render çıktısı takipsiz birikti.
tmp/
output/
artifacts/
*.mp4
*.mp3
*.wav

# İstisna: repoya konan telifsiz ses varlıkları İZLENİR.
!assets/music/**
!assets/audio/**/*.mp3
!assets/sfx/**/*.wav
!assets/sfx/**/*.mp3
!assets/sfx/**/*.ogg
!assets/sfx/**/*.m4a
!assets/motion/sfx/*.wav

# Kimlik bilgileri asla commit edilmez.
serviceAccount*.json
firebase-*.json

# Cutout ara dosyaları (ham indirmeler) sürümlenmez; üretilen alfa PNG sürümlenir.
public/cutouts/.raw-*
# Arşivden indirilen ham dosyalar: kesilmiş PNG'ler kalır, hamlar commit'lenmez.
public/archive/.raw-*

# Flow klipleri sürümlenmez (büyük, elle üretiliyor); klasör yapısı kalır.
public/clips/*.mp4

# Kolaj ham görselleri: magenta zeminli, opak, türetilmiş veri. Alfa'ya
# çevrilmiş hâlleri public/collage/ altında ve ONLAR sürümlenir.
collage-raw/
