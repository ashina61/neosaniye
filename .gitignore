node_modules/
.env
.env.local
*.log

# Geçici üretim çıktıları (ses, video, indirilen klipler)
tmp/
output/
*.mp3
*.mp4
*.wav

# İstisna: repoya konan telifsiz müzik parçaları İZLENİR
!assets/music/**

# Firebase servis hesabı anahtarı asla commit edilmez
serviceAccount*.json
firebase-*.json

# Faz 5 yerel state (Firebase yoksa) — dedup için state dosyaları İZLENİR,
# gerisi (indirilen geçici veriler vb.) yok sayılır.
data/*
!data/used_topics.json
!data/videos.json
!data/qc-history.jsonl

# CC0 ses kütüphanesi (assets/audio) sürümlenir — global *.mp3 kuralının istisnası.
!assets/audio/**/*.mp3
# Manuel inceleme önizlemeleri (production seçicisi bu klasörü görmez).
!artifacts/audio-review/*.mp3

# Gerçek üretim doğrulaması: yerel/dev koşularının çıktısı commit'lenmez;
# GERÇEK artifact'lar CI workflow'unda (real-production-validation) üretilir.
artifacts/real-production-validation/

# Bee regresyon kanıtı (gerçek ffmpeg proof seti) — küçük ve sürümlenir.
!artifacts/regression/*.mp4
!artifacts/regression/*.png
!artifacts/regression/*.json
!artifacts/regression/*.md

# Neo Motion: SFX wav + manifest + showcase görselleri sürümlenir; ara render'lar değil.
!assets/motion/sfx/*.wav
# SFX havuzu (kullanıcı-sağlanan telifsiz geçiş sesleri) sürümlenir.
!assets/sfx/**/*.wav
!assets/sfx/**/*.mp3
!assets/sfx/**/*.ogg
!assets/sfx/**/*.m4a
artifacts/motion/*
!artifacts/motion/cta-contact-sheet.png
!artifacts/motion/safe-area-debug.png
!artifacts/motion/acceptance/
artifacts/motion/acceptance/videos/
artifacts/motion/acceptance/screenshots/

# Render çıktıları — üretim artefaktı, depoya girmez.
out/
