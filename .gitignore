node_modules/
.env
.env.local
*.log

# Geçici üretim çıktıları (ses, video, indirilen klipler)
tmp/
output/
*.mp3
*.mp4
*.wav

# İstisna: repoya konan telifsiz müzik parçaları İZLENİR
!assets/music/**

# Firebase servis hesabı anahtarı asla commit edilmez
serviceAccount*.json
firebase-*.json

# Faz 5 yerel state (Firebase yoksa) — dedup için state dosyaları İZLENİR,
# gerisi (indirilen geçici veriler vb.) yok sayılır.
data/*
!data/used_topics.json
!data/videos.json
!data/qc-history.jsonl

# CC0 ses kütüphanesi (assets/audio) sürümlenir — global *.mp3 kuralının istisnası.
!assets/audio/**/*.mp3
# Manuel inceleme önizlemeleri (production seçicisi bu klasörü görmez).
!artifacts/audio-review/*.mp3

# Neo Motion: SFX wav + manifest + showcase görselleri sürümlenir; ara render'lar değil.
!assets/motion/sfx/*.wav
artifacts/motion/*
!artifacts/motion/cta-contact-sheet.png
!artifacts/motion/safe-area-debug.png
