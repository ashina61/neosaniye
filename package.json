{
  "name": "crime-reels",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vertical crime documentary reels — one shared engine, many episodes",
  "engines": {"node": ">=20"},
  "scripts": {
    "render": "node scripts/render-episode.mjs",
    "validate": "node scripts/validate-episode.mjs",
    "studio": "remotion studio engine/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\"",
    "assets:placeholder": "node scripts/make-placeholder-assets.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.499",
    "@remotion/cli": "4.0.499",
    "@remotion/renderer": "4.0.499",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.499"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "typescript": "5.9.2"
  }
}
