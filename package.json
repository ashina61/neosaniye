{
  "name": "neosaniye",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Premium procedural Remotion tabanlı otomatik NeoSaniye Shorts fabrikası",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "produce": "node scripts/generate-and-publish.js",
    "produce:dry": "node scripts/generate-and-publish.js --no-upload",
    "script": "node scripts/generate-script.js",
    "script:save": "node scripts/generate-script.js --save",
    "audio": "node scripts/generate-audio.js",
    "video": "node scripts/render-video.js",
    "test": "node --test",
    "test:remotion": "node --test test/remotionSpec.test.js test/remotionOnly.test.js",
    "check": "npm test && npm run remotion:typecheck",
    "upload": "node scripts/upload-youtube.js",
    "youtube:auth": "node scripts/youtube-auth.js",
    "audio:import": "node scripts/audio-import.js",
    "audio:import:dry": "node scripts/audio-import.js --dry-run",
    "remotion:install": "npm install --prefix remotion --no-audit --no-fund",
    "remotion:studio": "npm --prefix remotion run studio",
    "remotion:typecheck": "npm --prefix remotion run typecheck",
    "remotion:fixture": "npm --prefix remotion run render:fixture"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "dotenv": "^16.4.5",
    "firebase-admin": "^12.7.0",
    "googleapis": "^144.0.0"
  }
}
