{
  "name": "neosaniye",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "NeoSaniye: editorial cut-paper collage Shorts factory (Remotion render engine)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "beats": "node pipeline/build-storyboard.mjs",
    "cutouts": "node pipeline/generate-cutouts.mjs",
    "flow:pack": "node pipeline/build-flow-pack.mjs",
    "clips": "node pipeline/ingest-clips.mjs",
    "render": "remotion render src/index.ts Short out/neosaniye.mp4 --codec=h264 --crf=17 --pixel-format=yuv420p",
    "render:still": "remotion still src/index.ts Short out/still.png",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.mjs\"",
    "archive": "node pipeline/fetch-archive.mjs",
    "sheet": "node pipeline/contact-sheet.mjs",
    "preview": "remotion render src/index.ts Short out/preview.mp4 --codec=h264 --crf=30 --pixel-format=yuv420p --scale=0.3",
    "collage": "node pipeline/ingest-collage.mjs",
    "gate:templates": "node pipeline/template-gate.mjs",
    "topic": "node pipeline/pick-topic.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.500",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.500"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "typescript": "5.9.2"
  }
}
