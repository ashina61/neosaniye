{
  "name": "neosaniye-remotion",
  "version": "4.0.0",
  "private": true,
  "description": "NeoSaniye provider-fallback editorial collage Shorts factory",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "factory:preflight": "node scripts/factory-preflight.mjs",
    "story:generate": "node scripts/generate-story.mjs",
    "images:generate": "node scripts/generate-vox-images.mjs",
    "story:compile": "node scripts/compile-vox-story.mjs",
    "audio:bed": "node scripts/generate-audio-bed.mjs",
    "audio": "npm run audio:bed && node scripts/generate-voice-and-timing.mjs",
    "assets:generate": "node scripts/generate-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "render": "remotion render src/index.ts NeoSaniyeVox out/neosaniye-vox.mp4 --codec=h264 --crf=17 --pixel-format=yuv420p",
    "factory": "npm run factory:preflight && npm run story:generate && npm run images:generate && npm run story:compile && npm run audio && npm test && npm run typecheck && npm run render",
    "build:short": "npm run factory"
  },
  "dependencies": {
    "@remotion/cli": "4.0.500",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.500"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "typescript": "5.9.2"
  }
}
