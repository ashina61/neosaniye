{
  "name": "neosaniye",
  "version": "0.1.0",
  "description": "Otomatik faceless YouTube Shorts üretim ve yayınlama pipeline'ı",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "produce": "node scripts/generate-and-publish.js",
    "produce:dry": "node scripts/generate-and-publish.js --no-upload",
    "script": "node scripts/generate-script.js",
    "script:save": "node scripts/generate-script.js --save",
    "audio": "node scripts/generate-audio.js",
    "media": "node scripts/fetch-media.js",
    "video": "node scripts/render-video.js",
    "test": "node --test",
    "upload": "node scripts/upload-youtube.js",
    "youtube:auth": "node scripts/youtube-auth.js",
    "music": "node scripts/fetch-music.js",
    "audio:import": "node scripts/audio-import.js",
    "audio:import:dry": "node scripts/audio-import.js --dry-run"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "dotenv": "^16.4.5",
    "firebase-admin": "^12.7.0",
    "googleapis": "^144.0.0"
  }
}
