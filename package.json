{
  "name": "neosaniye-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "NeoSaniye için sıfırdan Remotion video projesi",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "render": "remotion render src/index.ts NeoSaniyeShort out/neosaniye-short.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p"
  },
  "dependencies": {
    "@remotion/cli": "4.0.500",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.500"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "typescript": "5.9.2"
  }
}
