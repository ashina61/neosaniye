# ---- FAZ 1: Script üretimi (Anthropic / Claude) ----
# https://console.anthropic.com adresinden alınır.
ANTHROPIC_API_KEY=

# Kullanılacak model. Varsayılan: claude-sonnet-5 (hook kalitesi/maliyet dengesi iyi).
# Daha ucuz seçenek: claude-haiku-4-5
ANTHROPIC_MODEL=claude-sonnet-5

# İçerik dili ve teması
CONTENT_LANGUAGE=tr
CONTENT_THEME=ilginç bilgiler, nasıl çalışır, nasıl yapılır

# ---- FAZ 5: Firestore (kullanılmış konu / video geçmişi) ----
# Firebase servis hesabı JSON'unun TAMAMI tek satır olarak buraya (veya GitHub Secret'a).
# Boş bırakılırsa Firestore devre dışı kalır; script üretimi yine çalışır (yerel test).
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=

# ---- FAZ 3: Pexels (görsel/video) — sonraki fazlarda kullanılacak ----
PEXELS_API_KEY=

# ---- FAZ 6: YouTube (sonraki fazlarda kullanılacak) ----
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
