# NeoSaniye — Remotion-only örnek ortam değişkenleri

# ---------- İçerik ----------
CONTENT_LANGUAGE=en
CONTENT_THEME=interesting facts, how it works, how to
CONTENT_MIN_WORDS=95
CONTENT_MAX_WORDS=130
CONTENT_MIN_SECONDS=30
CONTENT_MAX_SECONDS=58
CONTENT_IDEAL_MIN_SECONDS=38
CONTENT_IDEAL_MAX_SECONDS=50
TREND_DISCOVERY=1

# ---------- Script sağlayıcıları ----------
# Tanımlı olmayan sağlayıcı otomatik atlanır.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4o-mini
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ---------- TTS ----------
TTS_ENGINE=auto
TTS_VOICE=en-US-AndrewNeural
TTS_RATE=-2%
TTS_PITCH=+0Hz
PIPER_VOICE=en_US-ryan-high
PIPER_DATA_DIR=models/piper
WHISPER_MODEL=base

# ---------- Görsel sağlayıcılar ----------
PEXELS_API_KEY=
PIXABAY_API_KEY=
IMAGE_PROVIDER_CHAIN=pollinations,cloudflare,together,huggingface
TOGETHER_API_KEY=
TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell-Free
HUGGINGFACE_API_KEY=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# ---------- Remotion ----------
# GitHub Actions için 2 güvenli varsayılandır; güçlü yerel makinede yükseltilebilir.
REMOTION_CONCURRENCY=2
# Debug sırasında public/runs/<video> klasörünü korumak için 1; normalde boş/0.
REMOTION_KEEP_PUBLIC_RUNS=0

# ---------- Ses tasarımı ----------
# Remotion kendi özgün procedural müziğini ve SFX paketini üretir.
# Freesound yalnız isteğe bağlı ambiyans kaynağıdır.
FREESOUND_API_KEY=
VIDEO_AMBIENCE=1
VIDEO_MUSIC=1
VIDEO_SFX=1

# ---------- Kalite kapıları ----------
RETENTION_QC_MODE=warning
RETENTION_MIN_SCORE=75
RETENTION_QUALITY_TARGET=90
TECHNICAL_PREFLIGHT_MODE=strict

# ---------- Upload politikası ----------
# Komut satırındaki --upload / --no-upload ile birlikte değerlendirilir.
AUTO_UPLOAD=false
REQUIRE_MANUAL_APPROVAL=true

# ---------- Firestore / kalıcı durum ----------
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=

# ---------- YouTube ----------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=unlisted
YOUTUBE_CATEGORY_ID=27

# ---------- Instagram + Facebook ----------
META_USER_TOKEN=
META_IG_LOGIN_TOKEN=
META_PAGE_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=

# ---------- Bildirim ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
