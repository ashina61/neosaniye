# Optional text/research providers. The VOX MVP never logs these values.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional image providers. Missing keys fall through to the local placeholder.
BFL_API_KEY=
STABILITY_API_KEY=
POLLINATIONS_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Comma-separated provider priority. No provider is called during --dry-run.
STORY_PROVIDER_CHAIN=
IMAGE_PROVIDER_CHAIN=
