# Optional text/research providers. The VOX MVP never logs these values.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional image providers. Missing keys fall through to the local placeholder.
BFL_API_KEY=
STABILITY_API_KEY=
POLLINATIONS_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Comma-separated provider priority. No provider is called during --dry-run.
STORY_PROVIDER_CHAIN=
IMAGE_PROVIDER_CHAIN=

# Safety locks. Acceptance defaults must remain exactly as shown.
AUTO_UPLOAD=false
REQUIRE_MANUAL_APPROVAL=true
ALLOW_PAID_GENERATION=false
ENABLE_AI_VIDEO=false
VOX_ENABLE_SCENE_HEADLINES=false
