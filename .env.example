# ---- FAZ 1: Script üretimi (Google Gemini) ----
# Ücretsiz anahtar, kart gerektirmez: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Kullanılacak model. Varsayılan: gemini-2.5-flash (ücretsiz tier).
# Daha hızlı/ucuz seçenek: gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash

# İçerik dili ve teması (kanal İngilizce konsept)
CONTENT_LANGUAGE=en
CONTENT_THEME=interesting facts, how it works, how to

# ---- FAZ 5: Firestore (kullanılmış konu / video geçmişi) ----
# Firebase servis hesabı JSON'unun TAMAMI tek satır olarak buraya (veya GitHub Secret'a).
# Boş bırakılırsa Firestore devre dışı kalır; script üretimi yine çalışır (yerel test).
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=

# ---- FAZ 2: Seslendirme (edge-tts ana + Piper yedek, ücretsiz, API key yok) ----
# auto = önce edge-tts, 403/hata olursa Piper. Zorlamak için: edge | piper
TTS_ENGINE=auto

# edge-tts (ana) — popüler erkek US sesi. Alternatif: en-US-BrianNeural,
# en-US-GuyNeural, en-US-ChristopherNeural, en-US-EricNeural
TTS_VOICE=en-US-AndrewNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# Piper (çevrimdışı yedek) — erkek ses. Alternatif: en_US-lessac-medium
PIPER_VOICE=en_US-ryan-high
PIPER_DATA_DIR=models/piper

# whisper (yalnızca Piper yolunda kelime zamanlaması): base | small | medium
WHISPER_MODEL=base

# ---- FAZ 3: Pexels (görsel/video) — sonraki fazlarda kullanılacak ----
PEXELS_API_KEY=

# ---- Pixabay: ikinci ücretsiz stok kaynağı (Pexels bulamayınca denenir) ----
# Ücretsiz anahtar: https://pixabay.com/api/docs/ (giriş yapınca sayfada görünür).
# Boş bırakılırsa sadece Pexels kullanılır.
PIXABAY_API_KEY=

# ---- Freesound: sahne ambiyansı (ortam sesi, CC0 filtreli) ----
# Ücretsiz anahtar: https://freesound.org/apiv2/apply/ (hesap + kısa form).
# Boş bırakılırsa ambiyans katmanı atlanır; video yine normal çıkar.
FREESOUND_API_KEY=

# ---- FAZ 6: YouTube otomatik upload (bkz. docs/youtube-oauth-setup.md) ----
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# İlk testlerde private/unlisted önerilir: public | unlisted | private
YOUTUBE_PRIVACY=public
# 27 = Education, 24 = Entertainment, 28 = Science & Technology
YOUTUBE_CATEGORY_ID=27

# ---- Instagram + Facebook cross-post (opsiyonel; bkz. docs/meta-setup.md) ----
# TEK zorunlu değer: uzun ömürlü kullanıcı token'ı. Sayfa + Instagram
# otomatik keşfedilir. Boşsa cross-post atlanır; YouTube akışı etkilenmez.
META_USER_TOKEN=
# (opsiyonel elle sabitleme — normalde gerekmez)
META_PAGE_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=

# ---- Bildirim (opsiyonel; ikisi de boşsa sessizce atlanır) ----
# Telegram: BotFather'dan bot oluştur, token'ı yapıştır; bota bir mesaj at,
# sonra api.telegram.org/bot<TOKEN>/getUpdates çıktısındaki chat.id'yi al.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: kanal ayarları -> Integrations -> Webhooks -> New Webhook -> URL.
DISCORD_WEBHOOK_URL=

# ---- Trend keşfi (Reddit TIL'den konu tohumları; kapatmak için 0) ----
TREND_DISCOVERY=1

# ---- EK ÜCRETSİZ YEDEK BEYİNLER (script üretimi) ----
# Gemini + Groq + OpenRouter aynı anda kota/limit yiyince tüm run çöpe gidiyordu.
# Aşağıdakiler OpenAI-uyumlu uçlardır; TANIMLI OLMAYAN SESSİZCE ATLANIR.
# Zincir sırası: Gemini -> Groq -> Cerebras -> GitHub Models -> Mistral -> Cloudflare -> OpenRouter

# GitHub Models — ÜCRETSİZ, AYRI KAYIT GEREKTİRMEZ. GitHub Actions içinde
# secrets.GITHUB_TOKEN yeterli (workflow'da `permissions: models: read` var).
# Yerelde denemek istersen: repo/models izinli bir Personal Access Token.
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Cerebras — cloud.cerebras.ai (ücretsiz katman, çok hızlı)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# Mistral — console.mistral.ai (ücretsiz katman)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Cloudflare Workers AI — dash.cloudflare.com (günlük ücretsiz kota)
# İKİSİ de gerekli; biri eksikse sağlayıcı atlanır.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ---- ÜCRETSİZ GÖRSEL SAĞLAYICI YEDEKLERİ ----
# Pollinations tek nokta olmasın: düşerse tüm sahneler stok görsele düşüyor ve
# "slayt" hissi geri geliyor. Sıra IMAGE_PROVIDER_CHAIN ile değiştirilebilir.
# Varsayılan: pollinations,cloudflare,together,huggingface
# (cloudflare, metin tarafıyla AYNI CLOUDFLARE_* değişkenlerini kullanır)
IMAGE_PROVIDER_CHAIN=pollinations,cloudflare,together,huggingface

# Together AI — FLUX.1-schnell-Free (ücretsiz uç): api.together.xyz
TOGETHER_API_KEY=
TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell-Free

# Hugging Face Inference API (ücretsiz katman): huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
